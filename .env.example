# --- Supabase (obbligatorio) -------------------------------------------------
# Dashboard Supabase → Project Settings → API.
# La chiave pubblicabile (o "anon") può stare nel browser: i dati sono
# protetti dalla Row Level Security definita in supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Intelligenza artificiale (facoltativo) ----------------------------------
# Solo lato server: non usare mai il prefisso NEXT_PUBLIC_ per questa chiave.
# Senza chiave l'app funziona con il motore di stile e l'estrazione dei colori.
ANTHROPIC_API_KEY=
# anthropic | none
AI_PROVIDER=anthropic
# Modello usato per analisi foto e outfit.
AI_MODEL=claude-opus-5-5
# Numero massimo di chiamate AI per utente nelle ultime 24 ore.
AI_DAILY_LIMIT=60
