# --- Supabase (obbligatorio) -------------------------------------------------
# Dashboard Supabase → Project Settings → API.
# La chiave pubblicabile (o "anon") può stare nel browser: i dati sono
# protetti dalla Row Level Security definita in supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Intelligenza artificiale (facoltativo) ----------------------------------
# Solo lato server: non usare mai il prefisso NEXT_PUBLIC_ per queste chiavi.
# Senza chiavi l'app funziona con il motore di stile e l'estrazione dei colori.
# Google Gemini (predefinito, gratuito con limiti): aistudio.google.com
GEMINI_API_KEY=
# Claude (alternativa a pagamento): console.anthropic.com
ANTHROPIC_API_KEY=
# gemini | anthropic | none. Se vuoto: Gemini se c'è la chiave, poi Claude.
AI_PROVIDER=
# Modello specifico (facoltativo). Con Gemini, se vuoto, viene scelto da solo
# un modello "flash" disponibile.
AI_MODEL=
# Numero massimo di chiamate AI per utente nelle ultime 24 ore.
AI_DAILY_LIMIT=60
